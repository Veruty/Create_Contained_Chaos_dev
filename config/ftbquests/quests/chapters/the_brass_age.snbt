		{
			dependencies: [
				"1D1FE294A7E4C824"
				"3DD8F79E6FCD8697"
			]
			description: ["Deployers are a useful piece of Brass Age technology that allow you to automate actions that can normally only be performed by a player, such as attacking mobs and shearing sheep. They are also used for automating certain items."]
			disable_toast: true
			icon: "create:deployer"
