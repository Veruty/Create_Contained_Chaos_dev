	quests: [
		{
			dependencies: ["42AA25C1E9AF0537"]
			description: [
				"Andesite Alloy is the most basic component construction material in Create."
				""
				"Among its many functions, it is an essential ingredient for crafting Shafts and both regular and large Cogwheels."
			]
			id: "7B196B74898CA9AD"
			rewards: [{
				count: 32
				id: "1617BF00F39F9AA2"
				item: "minecraft:andesite"
				type: "item"
			}]
			size: 1.5d
			tasks: [{
				id: "452EA773DB76C620"
				item: "create:andesite_alloy"
				type: "item"
			}]
			x: 0.5d
			y: -1.0d
		}
		{
			dependencies: ["7B196B74898CA9AD"]
			description: [
				"Andesite Casings are blocks used throughout many crafting recipes in Create, as well as for decoration and aesthetic purposes."
				""
				"Casings can only be crafted through physically applying a valid alloy or ingot to any Stripped variant of Log or Wood (this later can be automated with use of Deployer). The logs will convert themselves into the casing, where the player can either mine it with their preferred tool or use a Wrench to place the casing in their inventory."
				""
				"Mechanical Belts, Shafts, and Cogwheels can be encased in Andesite Casing, creating a decoration around the encased block."
			]
			id: "7DBC7E2955637282"
			rewards: [{
				count: 16
				id: "451769532DB96871"
				item: "create:andesite_alloy"
				type: "item"
			}]
			size: 1.5d
			tasks: [{
				id: "5A2FA2D5ECD3615D"
				item: "create:andesite_casing"
				type: "item"
			}]
			x: 6.5d
			y: -1.0d
		}
		{
			dependencies: ["7B196B74898CA9AD"]
			description: ["The shaft is a basic mechanical component in Create. It connects two mechanical components, allowing the rotation of one to transfer to the other."]
			id: "6D59BFAA88A72943"
			rewards: [{
				count: 8
