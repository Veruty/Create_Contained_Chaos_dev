			y: 4.5d
		}
		{
			dependencies: ["4C7918259EDF52EB"]
			description: [
				"A Mekanism machine upgrade to make them process items faster, you can install 8 of these in each Mekanism machine."
				""
				"The power consumption to speed growth ratio is non-linear. So at 8 speed upgrades the speed will be 10x but energy costs will be 100x."
				""
				"[ \"It is strongly advised to also install \", { \"text\": \"Energy Upgrades\", \"underlined\": \"true\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"3713AAB7A3F2E9A7\" } }, \" to balance out the energy cost.\" ]"
				""
				"&8Several machines do not follow this rule: Chemical Washer, Rotatory Condenser, Chemical Infuser, Isotopic Centrifuge, Electrolytic Separator, Pigment Mixer. For these machines every speed upgrade instead multiplies their speed by 2x, for a total of 256x speed. They still consume up to 100x the power per tick as usual.&r"
			]
			id: "1B1685D5DC2495F5"
			subtitle: "Speed it up!"
			tasks: [{
				id: "6C0D2EB8714246BA"
				item: "mekanism:upgrade_speed"
				type: "item"
			}]
			x: 18.0d
			y: 0.5d
		}
