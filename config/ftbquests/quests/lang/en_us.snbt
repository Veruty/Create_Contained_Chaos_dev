	quest.651BB3AF9ED9E341.quest_subtitle: "Baconator"
	quest.6560EBF0A0DBC0A5.quest_desc: ["[ \"Made with \", { \"text\": \"Godly Kinetic Alloy\", \"underlined\": \"true\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"7EF8903FCA281F93\" } } ]"]
	quest.66136119F1CB9705.title: "Unstable Alloy"
	quest.66E0DE92D75D0873.quest_desc: [
		"Copper Casings are blocks used throughout many crafting recipes in Create, as well as for decoration and aesthetic purposes."
		""
		"Casings can only be crafted through physically applying a valid alloy or ingot to any Stripped variant of Log or Wood (this later can be automated with use of Deployer). The logs will convert themselves into the casing, where the player can either mine it with their preferred tool or use a Wrench to place the casing in their inventory."
		""
		"Copper casings can be used on Fluid Pipes to encase them."
	]
	quest.66FD815724870C36.title: "Dust"
	quest.67B38F75568A3EA1.quest_desc: [
		"The Packager is used to create Cardboard Packages."
		""
		"When placed adjacent to any inventory, Packagers can create Cardboard Packages from the inventory they’re attached to. The process does not require extra materials."
		""
		"When powered with a Redstone signal, the packager attempts to fill the package as much as possible. A Cardboard Package has 9 slots of inventory. Placing a written sign on the Packager labels the created Cardboard Package with an address to be sent to."
		""
		"When a Stock Link is placed on a Packager, the Packager can receive requests from a Logistics Network. It can create packages with an address, specific items, and a specific amount of items."
		""
		"The Re-Packager is used to merge multiple Cardboard Packages that contain one recipe for a Mechanical Crafter."
	]
	quest.67BD5D776F242F93.quest_desc: [
		"The canteen can be filled with Nutritional Paste from the Nutritional Liquifier."
		""
		"It effectively replaces all food in the game, filling the player's hunger bar to full from its current position when consumed. This consumes an amount of paste proportional to the number of hunger points filled."
	]
	quest.67C595A66DBCDF9F.quest_subtitle: "You saw that one coming, didn't you?"
	quest.67C595A66DBCDF9F.title: "Sawmill"
	quest.67DC5768F0DF7E4A.quest_desc: ["Can place dirt ANYWHERE even in the air, at the cost of mana of course"]
	quest.67DC5768F0DF7E4A.quest_subtitle: "Dirty stick mk II"
	quest.67FB60B7BEEB1B0F.quest_desc: ["Create one of the Seasonal Runes, which are very powerful. needed for advanced rituals"]
	quest.67FB60B7BEEB1B0F.quest_subtitle: "The Season... of Rune!"
	quest.67FB60B7BEEB1B0F.title: "Seasonal Runes"
	quest.68156D92EAC1E80C.quest_desc: ["Mechanical Arms are made with a Precision Mechanism and a few other things, and are very useful for automation. They can be set to pick up items from sources and put them somewhere else."]
	quest.68156D92EAC1E80C.title: "Mechanical Arms"
	quest.68D9DEF49C85661C.quest_desc: [
		"Pressurized Tubes are used to transport Gases. "
		""
		"[ \"The behavior of each of the pipe's connection can be changed by Shift + right-clicking the end of a pipe with a \", { \"text\": \"Configurator\", \"underlined\": \"true\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"2E5025697AF514D2\" } }, \":\" ]"
		"&6Normal&r — passive"
		"&aPush&r — actively inserts items"
		"&ePull&r — actively extracts items"
		"None — disables connection"
		""
		"[ \"Can be colored to avoid confusion and stop different pipes from conecting to eachother, to do this Shift + Right-click base of the pipe with a \", { \"text\": \"Configurator\", \"underlined\": \"true\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"2E5025697AF514D2\" } } ]"
		""
		"&8Can be upgraded with Alloys by either combining 8 pipes and 1 alloy, or by right-clicking the pipe while Alloy is in hand.&r"
	]
	quest.68D9DEF49C85661C.quest_subtitle: "Pass the gas"
	quest.68DC3A875E494615.quest_desc: ["Create an Elven Mana spreader, which transfers much more mana at a much higher and faster rate."]
	quest.68DC3A875E494615.quest_subtitle: "So elfish "
	quest.692C1E964AB5B540.quest_desc: ["A basic ingredient in serums."]
	quest.692C1E964AB5B540.quest_subtitle: "Good Stuff"
	quest.6965BE7C00A6C26F.quest_desc: [
		"The Mechanical Plough is a component used to break non-collidable blocks and till dirt."
		""
		"While attached to a Contraption, the Mechanical Plough will break non-collidable blocks it comes in contact with (ex. snow layers). The Mechanical Plough will also move or launch entities and till soil blocks."
		""
		"While attached to a Contraption, the Mechanical Plough will till any grass blocks below it (change grass blocks to farmland), which can be used to quickly till huge farms."
	]
	quest.699D4CEBDED9D90B.quest_desc: [
		"A Fission Reactor Logic Adapter is a block used to remotely control a Fission Reactor. "
		""
		"With one installed, the user can use various events or conditions to control the reactor automatically with no manual input. This is useful for prevention of meltdowns. "
		""
		"&8Also has intigration with CC: Tweaked&r"
	]
	quest.699D4CEBDED9D90B.quest_subtitle: "Only Logical Solution"
	quest.69A7FB4817F3010F.quest_desc: ["Obtain a Terra Tools, which is much stronger than regular tools, some with hidden abilities!"]
	quest.69A7FB4817F3010F.quest_subtitle: "Magic Sticks"
	quest.69A7FB4817F3010F.title: "Terra Tools"
	quest.6A50B0A58B1E2802.quest_desc: ["[ \"Made with \", { \"text\": \"Energy Godly Alloy\", \"underlined\": \"true\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"0939986F6B65AA69\" } } ]"]
	quest.6A546B3E93E58AC8.quest_desc: [
		"The Electric Pump is a device with an internal buffer of 10000mB worth of fluid. It can pump any fluid that is covered in the forge fluid dictionary and can be placed on a shoreline and will pump the fluid under it.  "
		""
		"Unless it is collecting water, it will consume the liquid source block it collects. Electric pumps have a range of 80 blocks in all directions."
		""
		"&8Filter Upgrade can be installed into the pump, it allows the pump to collect heavy water from water.&r"
	]
