	quest.5A4CFE4FD8D50B72.quest_desc: ["The Fluidic Plenisher is the exact opposite of the Electric Pump. Instead of pumping fluids out of an area, the Fluidic Plenisher \"floods\" an area below it until all available open blocks are filled, or until it runs out of liquid to place."]
	quest.5A4F459C190B85D8.quest_desc: ["Will generate mana for you and will store it in your mana tablet!"]
	quest.5A4F459C190B85D8.quest_subtitle: "Passive income"
