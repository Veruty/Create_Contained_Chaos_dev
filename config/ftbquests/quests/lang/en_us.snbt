	quest.4AC56FA9013CD02E.quest_desc: [
		"New Age Generator is used to generate FE from SU."
		""
		"It consists of 3 main parts: "
		"- Carbon Brushes "
		"- Generator Coils (Rotor) "
		"- Magnetic Blocks (Stator)"
		""
		"To assemble the Generator place Generator Coils and surround it with 12 Magnets. Put Carbon Brushes on one end of the shaft that Generator Coils are placed on,"
		""
		"Output power depends on Magnetic Force of the Magnets and RPM of Generator Coils."
	]
	quest.4AC56FA9013CD02E.title: "How to: New Age Generator"
