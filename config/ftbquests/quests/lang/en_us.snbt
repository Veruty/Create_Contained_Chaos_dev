	quest.453AF22EDC7B77EF.quest_desc: [
		"Schematic And Quill is used for saving a structure as an .nbt file."
		""
		"If a Schematic is saved, it can be copied onto an Empty Schematic with a Schematic Table. This can be done across worlds."
		""
		"Schematic holds a structure to be positioned and placed in the world. Position the Hologram as desired and use a Schematicannon to build it."
		""
		"The Schematicannon will take the blocks required to build the structure from any adjacent inventories. The cannon will accept any inventory-type block as long as it has the function to output its contents. The cannon feeds on Gunpowder, consuming once for every 400 blocks."
	]
	quest.453AF22EDC7B77EF.title: "Schematica"
