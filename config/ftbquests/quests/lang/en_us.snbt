	quest.75867133DC826B4C.quest_subtitle: "{info.thermal.device_fisher.2}"
	quest.759171FDCBE90927.title: "D-T Fuel"
	quest.75BA8DAE253D5BAF.quest_desc: ["The Digital Miner is the scale mining machine of Mekanism. However, this machine just teleports mined blocks to its inventory."]
	quest.7631B69595DE7DA6.quest_desc: ["{info.thermal.dynamo_numismatic.0}"]
	quest.7631B69595DE7DA6.quest_subtitle: "{info.thermal.dynamo_numismatic.2}"
	quest.770BCA67195C96C3.quest_desc: [
		"A Wrench can be used to give the tunnel windows."
		""
		"The Tunnel does not stop items on the belt from being processed by an Encased Fan, but does stop the airflow from going beyond the belt."
		""
		"Andesite Tunnels can also be used to separate single items from passing stacks to side outputs."
	]
	quest.770BCA67195C96C3.title: "Andesite Tunnel"
	quest.776CB43BA45FE4DC.quest_desc: [
		"Robit is Mekanism's mechanical companion. It can act as a crafting grid, a furnace, an anvil, a chest, or simply a cute little buddy. It is immune to fire, including the Flamethrower. "
		"&8It also has some alternate skins.&r"
	]
	quest.7772E5BC5E558726.quest_desc: ["Ultimate Tier Installers can be used on Elite Factories to turn them into Ultimate Factories"]
	quest.7776B4E09E926234.quest_desc: ["Reactor Glass can be used to provide a view into the Fission Reactor. It can be used in place of Reactor Frame when building the Reactor, but cannot be placed on edges."]
	quest.77E41E8DAB050A8D.quest_desc: [""]
	quest.785EDF40D817A352.quest_desc: ["[ \"Bucket of sticky liquid, used to may \", { \"text\": \"Syrup\", \"underlined\": \"true\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4EAB51A2297C9B12\" } }, \".\" ]"]
	quest.788C6D3A4279C099.quest_desc: [
		"The Valve Handle functions much like the Hand Crank, but the amount and direction it rotates with one use can be adjusted in its Value Settings Screen. The direction of rotation can also be inverted from the Valve's settings by sneak using the Valve Handle instead of using it."
		""
		"The valve handle can be dyed all 16 vanilla colors by right clicking it with the respective Dye. "
	]
	quest.7892A00AEF474B56.quest_desc: ["Obtain a Kekimurus, which will consume cake and generate mana!"]
	quest.7892A00AEF474B56.quest_subtitle: "mmmm cake "
	quest.78FA150F447544C8.quest_desc: ["[ \"Preassure dispersers are used in Turbine, place them on one layer with \", { \"text\": \"Rotational Complex\", \"underlined\": \"true\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"35BF1D9F8D139459\" } }, \".\" ]"]
	quest.791E9151EC37770F.quest_desc: ["Can store nearly infinite amounts of items, just 1 item at a time ;3"]
	quest.791E9151EC37770F.quest_subtitle: "Infinite storage"
	quest.79376EA1DDFFFD39.quest_desc: [
		"The Mechanical Pump is a necessary component for moving fluids with Create's fluid logistics system. It functions similarly to a Fluid Pipe and functions to push and pull fluids through connected pipes."
		""
		"A Mechanical Pump contains a cogwheel and can receive and relay rotation to and from other cogwheels. When this cogwheel is powered, the pump will move fluids through connected pipes, to a distance of up to fifteen blocks. If moving fluids a further distance is necessary, multiple pumps will need to be used."
		""
		"The direction the fluids will be moved can be reversed by right-clicking the pump with a wrench. This direction will be indicated by an arrow on the side of the pump."
	]
	quest.7937800A7D3DDD04.quest_desc: [
		"Radioactive Waste Barrels are used to store and get rid of radioactive materials."
		""
		"&8Usually Waste Barrel deletes 0.05mB/t (1mB per 1 second) of radioactive gas put into it, but in this modpack it is changed to 0.2mB/t (4mB per 1 second).&r"
	]
	quest.7937800A7D3DDD04.quest_subtitle: "Useless Waste"
	quest.79619B03DF0DE28F.quest_desc: ["Create a Petal Apothecary, used to create unique flowers, to generate mana or have other unique uses"]
	quest.79619B03DF0DE28F.quest_subtitle: "Jesse! We need to craft!"
	quest.799038DEE9B54AF9.quest_desc: [
		"The Millstone is a more basic equivalent to the Crushing Wheels, and is most likely the first of the two that the Player will construct. It is capable of applying milling recipes to any valid items inserted from above or from the sides with use of any instering block (funnel, pipes, etc.). "
		""
		"Unlike many create contraptions, millstones are capable of receiving rotational force from both cogs (from the side) and shafts (from the bottom)."
	]
	quest.79B60FE2BB5F7049.quest_desc: ["{info.thermal.machine_insolator.0}"]
	quest.79B60FE2BB5F7049.quest_subtitle: "{info.thermal.machine_insolator.1}"
	quest.79E5B71B36FB83DC.title: "Tin Ingot"
	quest.7B16E9F7C8996C69.quest_desc: [
		"The Chemical Injection Chamber is mainly used to multiply ore. "
		""
		"It is the start of x4 ore processing and requires a steady supply of Hydrogen Chloride."
		""
		"[ \"Can also be used to \", { \"text\": \"repossess nuclear fuel\", \"underlined\": \"true\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4A90D76598166235\" } }, \".\" ]"
	]
	quest.7B196B74898CA9AD.quest_desc: [
		"Andesite Alloy is the most basic component construction material in Create."
		""
		"Among its many functions, it is an essential ingredient for crafting Shafts and both regular and large Cogwheels."
	]
	quest.7BBB19E7ACF3C68E.quest_desc: [
		"Your primordial cradle may start to create acid pools. "
		""
		"If you find any, look out for slimy looking blocks around them! If you collect enough of them, you can use them to craft a Caustic Gunblade."
	]
	quest.7BBB19E7ACF3C68E.quest_subtitle: "Holes?"
	quest.7BC2ECAB8B22CBFF.quest_desc: ["Only use is to create Sulfuric Acid"]
	quest.7BC2ECAB8B22CBFF.quest_subtitle: "Gas Sulfur³"
	quest.7BC2ECAB8B22CBFF.title: "Sulfur Trioxide"
	quest.7BDF641DB273182F.quest_desc: ["[ \"Turbine Rotor is one of the block responsible for generating electricity, \", { \"text\": \"Rotor Blades\", \"underlined\": \"true\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"21D2ECE01D979648\" } }, \" attach onto Rotor (2 per) and are actual block that\" ] responsible for generating power."]
	quest.7BDF641DB273182F.quest_subtitle: "Spin me right round"
	quest.7C12BF79C830C59D.quest_desc: ["Will bounce around in the jar when you're in a slime chunk, great for making  slime farm for unlimited mana!"]
	quest.7C12BF79C830C59D.quest_subtitle: "Boing!"
	quest.7C5B918C67AE83A3.title: "Liquid Lithium"
	quest.7CD7A649C0AD6C9C.quest_desc: [
		"{info.thermal.device_tree_extractor.0}"
		""
		"{info.thermal.device_tree_extractor.1}"
	]
	quest.7CD7A649C0AD6C9C.quest_subtitle: "{info.thermal.device_tree_extractor.2}"
	quest.7D8B1239CB87EA05.quest_desc: ["Will deal the same damage you take from a hit to all mobs around you. The cloak will go on cooldown after this."]
	quest.7D8B1239CB87EA05.quest_subtitle: "Ill take you down with me!"
	quest.7DBC7E2955637282.quest_desc: [
		"Andesite Casings are blocks used throughout many crafting recipes in Create, as well as for decoration and aesthetic purposes."
		""
		"Casings can only be crafted through physically applying a valid alloy or ingot to any Stripped variant of Log or Wood (this later can be automated with use of Deployer). The logs will convert themselves into the casing, where the player can either mine it with their preferred tool or use a Wrench to place the casing in their inventory."
		""
		"Mechanical Belts, Shafts, and Cogwheels can be encased in Andesite Casing, creating a decoration around the encased block."
	]
	quest.7DBE55A240CFD900.quest_desc: [
		"Basic Tier Installer is used to upgrade various machines into their Factory equivalent."
		""
		"Machines get +2 parrallel-processing slots upon upgrading."
	]
	quest.7DC0D577FE02F5E0.quest_desc: [""]
	quest.7DC0D577FE02F5E0.quest_subtitle: "Better then Uranium?"
	quest.7E0E25D5F3D2B7DD.quest_desc: ["Allows you to fly at the cost of mana, however only for a limited time... legends say that an eye could allow you to fly forever"]
	quest.7E747BD610CB2D21.quest_desc: ["Elite Energy Cube can hold 25.6 MFE"]
	quest.7E747BD610CB2D21.quest_subtitle: "Even Better Powerbank"
	quest.7EF8903FCA281F93.quest_desc: [
		"todo write cool text"
		""
		"Can Make:"
		""
		"[ \"\", { \"text\": \"Creative Motor\", \"underlined\": \"true\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"6560EBF0A0DBC0A5\" } }, \" from Create\" ]"
	]
	quest.7F1FC387AB804DD8.quest_desc: [
		"The Mechanical Press is a mechanical component that applies Pressing, Packing, and Compacting recipes to items below it. It is an important early-game item, as it is used to press Ingots into Sheets, which are important ingredients for higher-level components."
		""
		"The Mechanical Press is powered by an internal Shaft, accessed from two opposite sides. Much like Shafts, Presses will relay rotation along their axis. It processes items faster when it receives faster rotational power."
		""
		"By default, the Mechanical Press will apply Pressing recipes to items underneath it. When a Mechanical Press is placed above a Basin, it will apply Packing or Compacting recipes to ingredients in the Basin."
	]
	quest.7F6CA9B6F1E7E91F.title: "Elementum Armor"
	quest.7F9A49100E2C93D4.quest_desc: ["Intermediate product of HDPE Pellet creation, created in Pressurized Reaction Chamber (PRC) from 2 x Bio Fuel, Water and Hydrogen (Ethylene created as side-product)."]
	quest.7F9A49100E2C93D4.quest_subtitle: "notplastic"
	quest.7FAF60A06EC98E40.quest_desc: ["Allows you to triple jump!"]
	quest.7FAF60A06EC98E40.quest_subtitle: "SUPER TRANS!??!?!"
	quest.7FD99F0885299CBE.quest_desc: [
