	quest.5A8D403663663939.quest_desc: ["Will grant you full immunity to all fire."]
	quest.5A8D403663663939.quest_subtitle: "Begone Flame!"
	quest.5B073DB6C4609529.quest_desc: ["Mechanical Crafters are Brass Age blocks that can be placed next to each other to form a crafting grid. Some items require a larger crafting grid and can only be made with Mechanical Crafters, like a Crushing Wheel for example."]
	quest.5B073DB6C4609529.title: "Mechanical Crafters"
	quest.5B2F0ADC98DFCBF5.quest_desc: ["Increases the strength of an applied potion."]
