	quest.5C186460408D65A9.quest_subtitle: "Unlimited power!"
	quest.5C3102E69C6A0E4D.quest_desc: ["{item.thermal.aquachow.desc}"]
	quest.5CA942F751BD97B0.quest_desc: [
		"Have a spout filled with water nearby, and use a List Filter in a mixer to filter out the liquid to something you can use."
		""
		"You'll need the spout to clean the filter after every use."
	]
	quest.5CA942F751BD97B0.title: "The First Step in Processing"
	quest.5D158C9E4E99B156.quest_desc: [
		"A stationary Mechanical Drill will break blocks in the block in front of it."
		""
		"A Mechanical Drill moved by Contraptions will break blocks and damage entities with which it collides without needing a direct supply of Rotational Force."
		""
		"The time it takes for a Mechanical Drill to break a block is based on the Contraption's speed and the block's Hardness value. The damage dealt to entities is also based on the Contraption's speed."
	]
	quest.5DC1E18EF6862D39.quest_subtitle: "Bad for the Environment"
	quest.5DC1E18EF6862D39.title: "Diesel Generator"
	quest.5E0F9397FA83D61A.quest_desc: [
		"The Flesh Plunderer is a tool used for killing mobs/animals for a fleshy reward. "
		""
		"It is powerful, but has very low durability. You will want to have it to get started with obtaining fleshy materials."
	]
	quest.5E0F9397FA83D61A.quest_subtitle: "Harvesting Flesh"
	quest.5E791AEF5A169DBF.quest_desc: [
		"The Linked Controller is a remote control for Redstone Links."
		""
		"The Linked Controller uses player movement keys (walk, jump, and sneak) to send signals to receiving Redstone Links."
		""
		"To configure the Linked Controller, the player can Use the Linked Controller on an existing Redstone Link and press any movement key to bind Redstone Links with that frequency to that key. The player can also sneak-use with the Linked Controller to open the interface and manually assign frequencies to each movement key."
		""
		"When used, the player will be locked in place, movement keys instead triggering the corresponding Redstone Links."
	]
	quest.5EB39DE7A9ACCF49.quest_desc: [
		"&cCAN CAUSE A LOT OF LAG, USE IMMERSIVE ENGINEERING WIRES!&r"
		""
		"Electrical connectors and Wires are New Age solution to transferring energy."
		""
		"Has 2 modes:"
		"Inert - transfers energy via wires, outputs energy to the block it is connected to and can accept energy from block it is connected to"
		"Pull - mostly used for compatibility between mods, in this mode connector will try to actively pull energy from the block. "
		""
		"Ponder is available for this block"
	]
	quest.5EB39DE7A9ACCF49.quest_subtitle: "Worse Immersive Wires"
	quest.5EFF6E91F1D53CDF.quest_desc: [
		"A Stock Ticker is used to request items from a Logistics Network."
		""
		"Click a Stock Link with the Stock Ticker to connect it to that network. Place a Mob in a Seat or a Blaze Burner behind the Stock Ticker to turn it into a Stock Keeper"
		""
		"The Stock Keeper can see all the items on the network. The UI displays how many Stock Links are connected. If the Stock Keeper is left unlocked, players can search the network, request items, and give their requests an Address to be sent to."
	]
	quest.5F20BF6C046A0340.quest_desc: ["Using this rod, you can open the bifrost, making a rainbow bridge to walk across. this can be given to a livingwood avatar, so it will create a path whenever a player approaches."]
	quest.5F20BF6C046A0340.quest_subtitle: "The path to Asgard"
	quest.5F481D223087B765.quest_desc: ["After Centrifuging the filtrated liquid, you now have Liquid Estrogen, which can be compressed into Pills! You can now produce them infinitely. Enjoy!"]
	quest.5F481D223087B765.title: "Girl Power!"
	quest.5FB7F9FD671703FF.quest_desc: ["Cardboard is an item which is used as ingredient in crafting recipes."]
	quest.601EAEFED1542BFE.title: "Antimatter"
	quest.604FAD4704BAEAF7.quest_subtitle: "Smeltin' like its 3500 BC"
	quest.604FAD4704BAEAF7.title: "Alloy Kiln"
	quest.60872E585150C8D4.quest_desc: [
		"The Pressurized Reaction Chamber (PRC) is used primarily to create Substrate, HDPE Pellets, Sulfur, and Ethylene. "
		""
		"Can also be used to create some late-game crafting components."
	]
	quest.60872E585150C8D4.quest_subtitle: "Under preassure"
	quest.60CA950C9ACBAFB4.title: "Sodium"
	quest.613236E638C66692.quest_desc: ["If you find any of these little things growing on the outer areas of your flesh mound, that means it has grown enough to start trying to spread out to more areas! It will shoot at the land surrounding it to create more flesh veins."]
	quest.613236E638C66692.quest_subtitle: "It Spreads"
	quest.613236E638C66692.title: "Primal Bloom"
	quest.61380F4AE14D6D21.quest_desc: [
		"[ \"Upgraded Magnetite block created from regular Magnetite. It is 2nd best Magnet for \", { \"text\": \"New Age Generator\", \"underlined\": \"true\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4AC56FA9013CD02E\" } }]"
		""
		"&8Provides 8 Magnetic Power&r"
	]
	quest.61380F4AE14D6D21.quest_subtitle: "Enriched Attractive Rock"
	quest.613F96A1F6686DC2.quest_desc: ["Create a Runic Altar which can be used to create runes, which are needed to make better flowers and gear"]
	quest.613F96A1F6686DC2.quest_subtitle: "Woah magic!"
	quest.6193117CB7A3D8F7.title: "Contained Chaos Fumos"
	quest.61C979651BB832A7.quest_desc: ["Can place dirt at the cost of mana, great for a skyblock world, not so great in a regular one :p"]
	quest.61C979651BB832A7.quest_subtitle: "Dirty stick"
	quest.61D7232C6BFA68E1.quest_desc: ["Overcharged diamond is used in creation of some high-tier machinery like Reinforced Motor and Netherite Magnet"]
	quest.61DAEBB4FA84E63D.quest_desc: [
		"The Purification Chamber uses oxygen to refine Ores and shards into clumps. "
		""
		"Each ore makes 3 clumps, whereas each shard only gives one clump. "
		""
		"&8The oxygen can be provided externally as gas, or internally with an oxygen filled Gas Tank or flint.&r"
	]
	quest.61DAEBB4FA84E63D.quest_subtitle: "Pure Pure"
	quest.6214BE62213881D3.quest_subtitle: "The Hottest Topic"
	quest.6214BE62213881D3.title: "Arc Furnace"
	quest.6217A88DB7994CD6.quest_desc: [
		"The Water Wheel is a source of rotational power. It generates Rotational Force when water flows over."
		""
		"Compared to a Water Wheel, the Large Water Wheel rotates with half the speed, but generates twice the total stress capacity."
		""
		"The Water Wheel's appearance can be changed by right-clicking any type of Planks on it (even modded ones)."
	]
	quest.62675A010097C976.quest_desc: [
		"Getting to the brass age means you need to make brass. But to make brass, you need a way to supply heat to a mixer. To do that, you need a Blaze Burner."
		""
		"Find a Nether Fortress and bring an empty blaze burner with you so you can capture a blaze inside it and bring it back to the Overworld."
	]
	quest.62675A010097C976.title: "Finding a Fortress"
	quest.62CB0E4BDC7AF5DC.quest_desc: ["Will consume Leaves off of nearby trees and turn it into mana. has a cooldown between 1-5 minutes between munchs"]
	quest.62CB0E4BDC7AF5DC.quest_subtitle: "\"what should i eat?\" \"Probly a tree :3\""
	quest.62EB68FA87F80CED.quest_desc: [
		"Basic Induction Cell can hold up to 3.2 GFE"
		""
		"[ \"Can only be used as part of \", { \"text\": \"Induction Matrix\", \"underlined\": \"true\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"2ADB4087CB1B55B7\" } } ]"
	]
	quest.62EB68FA87F80CED.quest_subtitle: "Big Battery Cell"
	quest.6359276B4243403D.title: "Constantan Ingot"
	quest.63A5E8C0B3A1C355.quest_desc: ["Induction Ports are needed to input/output energy from Induction Matrix"]
	quest.63B3E84031F1A0EC.quest_desc: [
		"The Teleporter is a machine that allows for teleportation of entities (Mobs, Players, Thrown Items, etc.)"
		""
		"To teleport from it you need the Teleporter Frame to build a Teleporter Portal."
		""
		"The Teleporter Portal is a multi-block structure that allows the player to teleport between Teleporter Portals on the same frequency. They are configured by right-clicking the Teleporter block at the base of the Teleporter. Their security can be configured as Public or Private. They can be used to travel between dimensions. Teleporter doesnt need loaded chunks to be operational."
	]
	quest.63F29667796878B6.quest_desc: ["If you feed your primordial cradle some raw meats and golden apples, it might spawn a flesh blob! I know the flesh blob is cute... but you have to kill it. Just dont think about it too much, because you will have to kill many more of them in the future."]
	quest.63F29667796878B6.quest_subtitle: "Fleshy..."
	quest.63FC0955B7336ECC.quest_subtitle: "Hazardous Machinery"
	quest.63FC0955B7336ECC.title: "Crusher"
