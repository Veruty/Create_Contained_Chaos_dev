	quest.64561D6FFC9D8D8D.quest_subtitle: "JESSE! WE HAVE COOKED!"
	quest.6478FFE989ACDE0E.quest_desc: ["Will turn hostile mobs that hit you into allies for a short time"]
	quest.6478FFE989ACDE0E.quest_subtitle: "Omg yaaasss queen slay!"
	quest.6503991883B2A2FD.quest_desc: ["Feed this to your primordial cradle to give it a little boost! If you can sustainably make these to feed your cradle, you can get it to grow a lot faster."]
	quest.6503991883B2A2FD.quest_subtitle: "Yummy (not for you!)"
	quest.6517693766FB9201.quest_desc: ["Allows you to store mana that you can use on the go!"]
	quest.6517693766FB9201.quest_subtitle: "Portable Magic!"
